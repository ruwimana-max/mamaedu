import express from "express";
import { GoogleGenAI } from "@google/genai";
import rateLimit from "express-rate-limit";

const app = express();
const PORT = process.env.PORT || 10000;

app.use(express.json({ limit: "30kb" }));

// Allow requests from MamaEdu's GitHub Pages website.
app.use((req, res, next) => {
  const origin = req.headers.origin;
  const allowedOrigin = "https://ruwimana-max.github.io";

  if (!origin || origin === allowedOrigin) {
    res.setHeader("Access-Control-Allow-Origin", allowedOrigin);
  }

  res.setHeader("Vary", "Origin");
  res.setHeader("Access-Control-Allow-Methods", "GET, POST, OPTIONS");
  res.setHeader("Access-Control-Allow-Headers", "Content-Type");

  if (req.method === "OPTIONS") {
    return res.sendStatus(204);
  }

  next();
});

const limiter = rateLimit({
  windowMs: 60 * 1000,
  limit: 15
});

app.get("/health", (req, res) => {
  res.json({ status: "MamaEdu backend is running" });
});

app.post("/api/chat", limiter, async (req, res) => {
  try {
    if (!process.env.GEMINI_API_KEY) {
      return res.status(500).json({
        error: "AI service is not configured."
      });
    }

    const { history } = req.body;

    if (!Array.isArray(history) || history.length === 0) {
      return res.status(400).json({
        error: "Please provide a message."
      });
    }

    const validHistory = history.slice(-12);

    for (const item of validHistory) {
      if (
        !["user", "model"].includes(item.role) ||
        typeof item.text !== "string" ||
        item.text.length > 4000
      ) {
        return res.status(400).json({
          error: "Invalid conversation message."
        });
      }
    }

    if (validHistory.at(-1).role !== "user") {
      return res.status(400).json({
        error: "The latest message must be from the user."
      });
    }

    const ai = new GoogleGenAI({
      apiKey: process.env.GEMINI_API_KEY
    });

    const result = await ai.models.generateContent({
      model: process.env.GEMINI_MODEL || "gemini-flash-latest",
      contents: validHistory.map(item => ({
        role: item.role,
        parts: [{ text: item.text }]
      })),
      config: {
        systemInstruction: `
You are MamaEdu, a helpful AI learning and life companion.

Your personality is warm, patient, intelligent and encouraging.

Your responsibilities:
1. Answer educational questions clearly.
2. Help students understand biology, chemistry,
   physics, mathematics and other subjects.
3. Explain advanced secondary-school topics step by step.
4. Support everyday conversations respectfully.
5. Give useful examples when explaining difficult ideas.
6. Ask a relevant clarification when a question is unclear.
7. Never pretend to know something you do not know.

Use simple language when appropriate, but give detailed
answers when the student needs deeper explanations.

Respect privacy. Do not request passwords or sensitive
personal information. For serious personal problems,
encourage the student to seek support from a trusted adult.

You are MamaEdu. Do not claim to be a human.
        `,
        maxOutputTokens: 1200
      }
    });

    const answer = result.text;

    if (!answer) {
      return res.status(502).json({
        error: "MamaEdu could not generate an answer. Please try again."
      });
    }

    res.json({ answer });

  } catch (error) {
    console.error("MamaEdu AI error:", error.message);

    res.status(500).json({
      error: "MamaEdu is temporarily unavailable. Please try again."
    });
  }
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`MamaEdu backend running on port ${PORT}`);
});
